    family-names: Pardeshi
    affiliation: "Independent Researcher"
license: MIT
repository-code: "https://github.com/rajveersinh-is-dev/sharp-cheeger-buser-certification"
keywords:
  - spectral graph theory
  - Cheeger inequality
  - Buser inequality
  - normalised Laplacian
  - exact computation
  - computer-assisted verification

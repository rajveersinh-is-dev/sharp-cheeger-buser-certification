# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# LaTeX build intermediates (main.pdf IS tracked; intermediates are not)
*.aux
*.blg
*.log
*.out
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
paper/*.xdv

# Environments / editors
.venv/
venv/
env/
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Secrets -- must never be committed
.env
*.pem
*.key
id_rsa*
*_rsa*
*_ed25519*
credentials.json
secrets.*
token.txt

# Results: the verification summary IS tracked; large scratch files are not
results/*.npy
results/*.npz
results/scratch/